# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL) — matches docker-compose.yml defaults
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://wa:wa@localhost:5432/whatsapp_bulk?schema=public"

# ─────────────────────────────────────────────────────────────
# Redis (used by BullMQ for the send queue)
# ─────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────────────────────
# WhatsApp Cloud API (Meta)
# Get these from https://developers.facebook.com → your app → WhatsApp
# ─────────────────────────────────────────────────────────────
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your-waba-id"
WHATSAPP_ACCESS_TOKEN="your-long-lived-access-token"

# A token YOU choose; you enter the same value in the Meta webhook config.
WEBHOOK_VERIFY_TOKEN="choose-a-random-string"

# ─────────────────────────────────────────────────────────────
# Sending throttle — keep within your WhatsApp messaging tier.
# messages per second the worker is allowed to dispatch.
# ─────────────────────────────────────────────────────────────
SEND_RATE_PER_SECOND="20"
